  "rewrites": [
    {
      "source": "/api/reviews/:firm",
      "destination": "/api/public-page-content?resource=reviews&firm=:firm"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/public-page-content?resource=reviews"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://rank-my-prop.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/support-refresh",
      "destination": "/api/support-session?action=refresh"
    },
    {
      "source": "/operations-console",
      "destination": "/operations-console.html"
    },
    {
      "source": "/review-api",
      "destination": "/review-api.html"
    },
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/offers/:firm",
      "destination": "/offers/:firm.html"
    },
    {
      "source": "/prop-firms/:slug/reviews",
      "destination": "/prop-firms/:slug/reviews.html"
    },
    {
      "source": "/prop-firm-rules/:firm/:program",
      "destination": "/prop-firm-rules/:firm/:program.html"
    },
    {
      "source": "/prop-firm-rules/:firm",
      "destination": "/prop-firm-rules/:firm.html"
    },
    {
      "source": "/firm-rules",
      "destination": "/firm-rules.html"
    },
    {
      "source": "/compare/:comparison",
      "destination": "/compare/:comparison.html"
    },
    {
      "source": "/reviews",
      "destination": "/reviews.html"
    },
    {
      "source": "/firm-reviews",
      "destination": "/firm-reviews.html"
    },
    {
      "source": "/broker-coming-soon",
      "destination": "/broker-coming-soon.html"
    },
    {
      "source": "/:page(prop-news|prop-news-post|content-post|trading-guides|funding-strategies|trading-psychology|beginner-tutorials|giveaways|giveaway|listedprop|bestprop|beginner-friendly-firms|highest-rated-firms|best-instant-funding-firms|best-futures-prop-firms|best-hft-prop-firms|best-prop-firms-2026|cheapest-prop-firms|fast-payout-prop-firms|most-trusted-prop-firms|prop-firm-rules|firm-rules|aquafundeddetail|blueberrydetail|blueberryfundeddetail|blueguardiandetail|directfundingtraderdetail|finotivefundingdetail|firm-detail|fundednextdetail|funderprodetail|fx2fundingdetail|fxifydetail|goatfundedtraderdetail|instantfundingdetail|qtfundeddetail|swayfundeddetail|theproptradedetail|toponetraderdetail|traderscaledetail|wefunddetail|about|contact|legal|disclaimer|privacy-policy|terms|cookies-policy)",
      "destination": "/:page.html"
    },
    {
      "source": "/blog/blog-post-:id(\\d+)",
      "destination": "/blog/blog-post-:id.html"
    },
    {
      "source": "/:section(trading-guides|funding-strategies|trading-psychology|beginner-tutorials)/:slug",
      "destination": "/:section/:slug.html"
    },
    {
      "source": "/news/:slug",
      "destination": "/news/:slug.html"
    },
    {
      "source": "/prop-firms/:slug/:view(challenges|rules|spreads|announcements)",
      "destination": "/firm-detail.html?slug=:slug&view=:view"
    },
    {
      "source": "/prop-firms/:slug",
      "destination": "/prop-firms/:slug.html"
    },
    {
      "source": "/((?!api/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/404.html"
    }
  ]
}
