{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 20
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rankmyprop.in"
        }
      ],
      "destination": "https://www.rankmyprop.in/:path*",
      "permanent": true
    },
    {
      "source": "/discount",
      "destination": "/offers",
      "permanent": true
    },
    {
      "source": "/sitemap-challenge-rules.xml",
      "destination": "/sitemaps/challenge-rules.xml",
      "permanent": true
    },
    {
      "source": "/propfirmrule",
      "destination": "/prop-firm-rules",
      "permanent": true
    },
    {
      "source": "/prop-firms/:slug/rules",
      "destination": "/firm-rules?firm=:slug",
      "permanent": true
    },
    {
      "source": "/firm-reviews",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<firm>.+)"
        }
      ],
      "destination": "/prop-firms/:firm/reviews",
      "permanent": true
    },
    {
      "source": "/firm-reviews",
      "destination": "/reviews",
      "permanent": true
    },
    {
      "source": "/compare-prop-firms",
      "destination": "/compare",
      "permanent": true
    },
    {
      "source": "/prop-firms/traderscale",
      "destination": "/prop-firms/trader-scale",
      "permanent": true
    },
    {
      "source": "/prop-firms/blueberryfunded",
      "destination": "/prop-firms/blueberry-funded",
      "permanent": true
    },
    {
      "source": "/prop-firms/swayfunded",
      "destination": "/prop-firms/sway-funded",
      "permanent": true
    },
    {
      "source": "/prop-firms/toponetrader",
      "destination": "/prop-firms/top-one-trader",
      "permanent": true
    },
    {
      "source": "/prop-firms/goatfundedtrader",
      "destination": "/prop-firms/goat-funded-trader",
      "permanent": true
    },
    {
      "source": "/prop-firms/wefund",
      "destination": "/prop-firms/we-fund",
      "permanent": true
