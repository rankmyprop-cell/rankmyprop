      "destination": "/prop-firms/aqua-funded",
      "permanent": true
    },
    {
      "source": "/prop-firms/fx2funding",
      "destination": "/prop-firms/fx2-funding",
      "permanent": true
    },
    {
      "source": "/traderscaledetail",
      "destination": "/prop-firms/trader-scale",
      "permanent": true
    },
    {
      "source": "/blueberrydetail",
      "destination": "/prop-firms/blueberry-funded",
      "permanent": true
    },
    {
      "source": "/blueberryfundeddetail",
      "destination": "/prop-firms/blueberry-funded",
      "permanent": true
    },
    {
      "source": "/swayfundeddetail",
      "destination": "/prop-firms/sway-funded",
