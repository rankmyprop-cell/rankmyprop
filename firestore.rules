rules_version = '2';
service cloud.firestore {
  function isPrivileged() {
    return request.auth != null &&
      (request.auth.token.admin == true ||
       request.auth.token.email == "rankmyprop@gmail.com" ||
       request.auth.token.team_review == true ||
       request.auth.token.moderator == true);
  }

  function isOwnLikeDoc(likeId) {
    return request.auth != null &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.firmSlug is string &&
      likeId == request.resource.data.firmId + "_" + request.auth.uid;
  }

  function isLikeIncrement(firmId) {
    return request.auth != null &&
      !exists(/databases/$(database)/documents/firmLikes/$(firmId + "_" + request.auth.uid)) &&
      existsAfter(/databases/$(database)/documents/firmLikes/$(firmId + "_" + request.auth.uid)) &&
      request.resource.data.diff(resource.data).changedKeys().hasOnly(["followers"]) &&
      request.resource.data.followers is int &&
      resource.data.followers is int &&
      request.resource.data.followers == resource.data.followers + 1;
  }

  function isOwnUserDoc(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function canUpdateOwnUserDoc(userId) {
    return isOwnUserDoc(userId) &&
      (
        (resource.data.nameLocked == true
          ? request.resource.data.nameLocked == true &&
            request.resource.data.firstName == resource.data.firstName &&
            request.resource.data.lastName == resource.data.lastName
          : true) &&
        (
          request.resource.data.email == resource.data.email ||
          request.resource.data.email == request.auth.token.email
        )
      );
  }

  // Allow users to read and write their own data
  match /databases/{database}/documents/{userId}/{document=**} {
    allow read, write: if request.auth != null && request.auth.uid == userId;
  }

  // Allow admin users full access to all collections
  match /databases/{database}/documents/{document=**} {
    allow read, write: if request.auth != null && 
      request.auth.token.admin == true;
  }

  // Allow users with specific roles to access team review profiles
  match /databases/{database}/documents/{document=**} {
    allow read, write: if request.auth != null && 
      request.auth.token.admin == true ||
      request.auth.token.team_review == true ||
      request.auth.token.moderator == true;
  }

  // Deny access to sensitive admin-only collections for non-admins
  match /databases/{database}/documents/{document=**} {
    allow read, write: if request.auth != null && 
      request.auth.token.admin == true;
  }

  // Allow team review profile creation and updates for authorized users
  match /databases/{database}/documents/firmReviewProfiles/{firmProfileId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && 
      (request.auth.token.admin == true ||
       request.auth.token.email == "rankmyprop@gmail.com" ||
       request.auth.token.team_review == true ||
       request.auth.token.moderator == true);
  }

  match /databases/{database}/documents/users/{userId} {
    allow read: if isPrivileged() || isOwnUserDoc(userId);
    allow create: if isPrivileged() || isOwnUserDoc(userId);
    allow update: if isPrivileged() || canUpdateOwnUserDoc(userId);
    allow delete: if isPrivileged() || isOwnUserDoc(userId);
  }

  // Allow firm data updates for authorized users
  match /databases/{database}/documents/firms/{firmId} {
    allow read: if true;
    allow write: if request.auth != null && 
      (request.auth.token.admin == true ||
       request.auth.token.email == "rankmyprop@gmail.com" ||
       request.auth.token.team_review == true ||
       request.auth.token.moderator == true ||
       isLikeIncrement(firmId));
  }

  // Allow rating stats updates for authorized users
  match /databases/{database}/documents/firmRatingStats/{firmId} {
    allow read: if true;
    allow write: if request.auth != null && 
      (request.auth.token.admin == true ||
       request.auth.token.email == "rankmyprop@gmail.com" ||
       request.auth.token.team_review == true ||
       request.auth.token.moderator == true);
  }

  match /databases/{database}/documents/firmReviews/{firmId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null &&
      (request.auth.token.admin == true ||
       request.auth.token.email == "rankmyprop@gmail.com" ||
       request.auth.token.team_review == true ||
       request.auth.token.moderator == true);
  }

  match /databases/{database}/documents/offers/{offerId} {
    allow read: if true;
    allow write: if request.auth != null &&
      (request.auth.token.admin == true ||
       request.auth.token.email == "rankmyprop@gmail.com" ||
       request.auth.token.team_review == true ||
       request.auth.token.moderator == true);
  }

  match /databases/{database}/documents/giveaways/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/pageCopy/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/pageHeadingsParagraphs/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/pageSeoContent/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/pageFaqs/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/siteSettings/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/announcements/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/newsletter/{docId} {
    allow create: if request.resource.data.keys().hasOnly(["email", "createdAt", "source"]) &&
      request.resource.data.email is string &&
      request.resource.data.email.size() >= 5 &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$") &&
      request.resource.data.source == "rankmyprop-homepage";
    allow read, update, delete: if isPrivileged();
  }

  match /databases/{database}/documents/firmFilters/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/bannedEmails/{docId} {
    allow get: if true;
    allow list, write: if isPrivileged();
  }

  match /databases/{database}/documents/purchases/{docId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/bonusOffers/{docId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/cashbackRequests/{docId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create: if request.auth != null &&
      request.resource.data.uid == request.auth.uid;
    allow update, delete: if isPrivileged();
  }

  match /databases/{database}/documents/referralClaims/{docId} {
    allow read: if isPrivileged() ||
      (request.auth != null &&
        (resource.data.uid == request.auth.uid || resource.data.referredUid == request.auth.uid));
    allow create: if request.auth != null &&
      request.resource.data.referredUid == request.auth.uid;
    allow update, delete: if isPrivileged();
  }

  match /databases/{database}/documents/rewardActions/{docId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/rewardLogs/{docId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/propNewsPosts/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/propNewsVideos/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/fundingStrategiesPosts/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/fundingStrategiesVideos/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/tradingPsychologyPosts/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/tradingPsychologyVideos/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/tradingGuidesPosts/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/tradingGuidesVideos/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/beginnerTutorialsPosts/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/beginnerTutorialsVideos/{docId} {
    allow read: if true;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/reviews/{reviewId} {
    allow read: if isPrivileged() ||
      resource.data.status in ["Approved", "approved", "Published", "published", "Publish", "publish"] ||
      (request.auth != null &&
        (
          resource.data.uid == request.auth.uid ||
          resource.data.userUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.reviewerUid == request.auth.uid ||
          resource.data.email == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email ||
          resource.data.reviewerEmail == request.auth.token.email
        )
      );
    allow create: if request.auth != null &&
      (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.reviewerUid == request.auth.uid ||
        request.resource.data.email == request.auth.token.email ||
        request.resource.data.userEmail == request.auth.token.email ||
        request.resource.data.reviewerEmail == request.auth.token.email
      );
    allow update, delete: if isPrivileged() ||
      (request.auth != null &&
        (
          resource.data.uid == request.auth.uid ||
          resource.data.userUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.reviewerUid == request.auth.uid ||
          resource.data.email == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email ||
          resource.data.reviewerEmail == request.auth.token.email
        )
      );
  }

  match /databases/{database}/documents/reviewReports/{reportId} {
    allow read: if isPrivileged() ||
      (request.auth != null &&
       exists(/databases/$(database)/documents/reviews/$(resource.data.reviewId)) &&
       get(/databases/$(database)/documents/reviews/$(resource.data.reviewId)).data.uid == request.auth.uid);
    allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
    allow update, delete: if isPrivileged();
  }

  // Dashboard claims: users may submit and read only their own claims.
  // Status changes and moderation remain restricted to privileged accounts.
  match /databases/{database}/documents/accountClaims/{claimId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create: if request.auth != null &&
      request.resource.data.uid == request.auth.uid;
    allow update, delete: if isPrivileged();
  }

  match /databases/{database}/documents/claims/{claimId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create: if request.auth != null &&
      request.resource.data.uid == request.auth.uid;
    allow update, delete: if isPrivileged();
  }

  match /databases/{database}/documents/claimRequests/{claimId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create: if request.auth != null &&
      request.resource.data.uid == request.auth.uid;
    allow update, delete: if isPrivileged();
  }

  match /databases/{database}/documents/tradeJournalEntries/{entryId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create, update: if request.auth != null &&
      request.resource.data.uid == request.auth.uid;
    allow delete: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
  }

  match /databases/{database}/documents/firmLikes/{likeId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create: if isOwnLikeDoc(likeId) &&
      request.resource.data.keys().hasOnly(["uid", "email", "firmSlug", "firmId", "createdAt"]);
    allow update, delete: if isPrivileged();
  }

  match /databases/{database}/documents/reviewReactionStats/{reviewId} {
    allow read: if true;
    allow write: if request.auth != null;
  }

  match /databases/{database}/documents/reviewReactionUsers/{docId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create, update: if request.auth != null &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.keys().hasOnly(["uid", "reviewId", "vote", "updatedAt", "createdAt"]);
    allow delete: if isPrivileged();
  }

  // Web Push tokens and delivery logs are managed by trusted Cloud Functions.
  // Privileged admins may inspect them in Firebase, but browsers cannot write
  // raw FCM tokens directly to Firestore.
  match /databases/{database}/documents/pushSubscriptions/{subscriptionId} {
    allow read: if isPrivileged();
    allow write: if false;
  }

  match /databases/{database}/documents/pushSendLogs/{logId} {
    allow read: if isPrivileged();
    allow write: if false;
  }

  // Games and quiz CRM. Players can read active configuration and keep their
  // own run history; all quiz authoring, campaign controls and reward review
  // actions stay with privileged Rank My Prop staff.
  match /databases/{database}/documents/gameSettings/{settingId} {
    allow read: if request.auth != null;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/gameQuizzes/{quizId} {
    allow read: if request.auth != null;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/gameQuestions/{questionId} {
    allow read: if request.auth != null;
    allow write: if isPrivileged();
  }

  match /databases/{database}/documents/gameResults/{resultId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    allow update, delete: if isPrivileged();
  }

  match /databases/{database}/documents/gameClaims/{claimId} {
    allow read: if isPrivileged() ||
      (request.auth != null && resource.data.uid == request.auth.uid);
    allow create: if request.auth != null &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.status == "pending";
    allow update, delete: if isPrivileged();
  }

  // One document per game/day lets a Firestore transaction reserve the daily
  // winner slot globally before its reward claim is sent for review.
  match /databases/{database}/documents/gameDailyWinners/{winnerId} {
    allow read: if request.auth != null;
    allow create: if request.auth != null &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.status == "pending";
    allow update, delete: if isPrivileged();
  }
}
