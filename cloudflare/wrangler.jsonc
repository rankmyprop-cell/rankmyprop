{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rankmyprop-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "rankmyprop.in/*", "zone_id": "7e4a484758b4a367fe2a2fb6419e9e0f" }
  ],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rankmyprop-db",
      "database_id": "6c2572cb-6359-4285-bf42-db706283dc90",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "rankmyprop-media" }
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "rankmyprop-jobs" }
    ],
    "consumers": [
      { "queue": "rankmyprop-jobs", "max_batch_size": 100, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "FIREBASE_PROJECT_ID": "rank-my-prop",
    "ALLOWED_ORIGINS": "https://www.rankmyprop.in,https://rankmyprop.in,https://rankmyprop-web.pages.dev,http://127.0.0.1:5173,http://localhost:5173",
    "ADMIN_EMAIL": "rankmyprop@gmail.com"
    ,"VAPID_SUBJECT": "mailto:rankmyprop@gmail.com"
    ,"VAPID_PUBLIC_KEY": "BF9HlG7St6-z7GobSF8TnO9to1FE5ufJwkCr5pZegQzI2r_okgnOX7YKXYadWaRmSzmNsGveJ8IPR9leqbbdVxY"
  }
}
